{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ftshare-etf-collector",
  "main": "../src/background/collector.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "FTSHARE_CACHE",
      "id": "3e687e22c6944fe0a09a0f01671be9f0"
    }
  ],
  "triggers": {
    "crons": [
      "* 1-3,5-7 * * MON-FRI"
    ]
  }
}
